# Etiqueta de las imágenes en ghcr.io/belcaik/open-nvr-* (latest o sha-<commit>).
OPENNVR_TAG=latest

# NVR y sondas de nvr-watch
NVR_HOST=192.168.0.227
NVR_HTTP_PORT=80
NVR_RTSP_PORT=554
NVR_RTSP_PATH=/live/0/SUB
NVR_USER=admin
# Usar los secretos de Podman en producción. Estas alternativas quedan vacías.
NVR_PASS=
NVR_PASS_FILE=
NVR_KNOWN_TCP_PORTS=80,554,6060,6066,8885,9000
SCAN_EXTRA_PORTS=
SCAN_ENABLED=true
CHECK_INTERVAL=60
BASELINE_INTERVAL=900
SCAN_INTERVAL=21600
FAIL_THRESHOLD=3
TIME_DRIFT_MAX=120
EXPECTED_GATEWAY=192.168.0.8
EXPECT_P2P_OFFLINE=true
P2P_ONLINE_STATES=internet-ready
IGNORE_PREFIXES=status.,camstatus.,ntp.LastSuccessSyncNTPTime,ntp.IsSynchronizeNTPNow,ntp.SynchronizeNTPNowStatus
BASELINE_REALERT=86400

# ntfy (NTFY_URL vacío deja los avisos solo en el log).
# Con el ntfy de este compose: NTFY_URL=http://ntfy:2586 (red interna).
# NTFY_BASE_URL es la URL pública del servidor (la que abre la app móvil) y
# NTFY_BIND y NTFY_PORT, la IP y el puerto del host donde se publica.
# En Baphomet el 8080 lo usa otro contenedor (gta-v-map); 2586 está libre.
NTFY_BASE_URL=http://192.168.0.8:2586
NTFY_BIND=192.168.0.8
NTFY_PORT=2586
NTFY_URL=
NTFY_TOPIC=opennvr
NTFY_TOKEN=
NTFY_TOKEN_FILE=
NOTIFY_MIN_INTERVAL=3600
NOTIFY_MAX_PER_HOUR=20

# Agregación de egress-watch
WINDOW_SECONDS=300
SPIKE_FACTOR=5.0
SPIKE_MIN_BYTES=1000000
SUMMARY_HOUR=8
SILENCE_ALERT_HOURS=6.0
POLL_SECONDS=5.0
LOG_MAX_BYTES=50000000
ULOG_FILES=/var/log/ulogd/nvr-fwd.json,/var/log/ulogd/nvr-drop.json
DNSMASQ_LOG=/var/log/dnsmasq/queries.log

# Rutas internas de los contenedores (compose las fija en /data).
DATA_DIR=/data

# Dirección LAN local donde el perfil opcional dnsmasq escucha DNS.
DNS_BIND=192.168.0.8

# Interfaz web (opennvr-web) y go2rtc
# WEB_LISTEN: IP:puerto del host. Caddy (rootless, en bridge) no alcanza el
# loopback del host, así que se usa la IP LAN y nftables solo deja entrar al
# propio host (regla fib saddr type local en deploy/baphomet/nftables).
WEB_LISTEN=192.168.0.8:8095
WEB_USER=admin
WEB_TRUSTED_PROXIES=127.0.0.1/32,192.168.0.8/32
CAMERA_CHANNELS=1,2,3,4
GO2RTC_TAG=1.9.15-hardware
GO2RTC_API=127.0.0.1:1984
GO2RTC_CANDIDATE=192.168.0.8:8555
GO2RTC_VAAPI=true
